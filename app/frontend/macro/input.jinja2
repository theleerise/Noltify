{% macro _build_attrs(field_name, field_config={}, extra_class='') -%}
    name="{{ field_name }}"
    id="id_{{ field_name }}"
    class="form-control{% if extra_class %} {{ extra_class }}{% endif %}{% if field_config.className %} {{ field_config.className }}{% endif %}"
    {% if field_config.placeholder %}placeholder="{{ field_config.placeholder }}"{% endif %}
    {% if field_config.required %}required{% endif %}
    {% if field_config.readonly %}disabled{% endif %}
    {% if field_config.maxlength %}maxlength="{{ field_config.maxlength }}"{% endif %}
    {% if field_config.minlength %}minlength="{{ field_config.minlength }}"{% endif %}
    {% if field_config.min is not none %}min="{{ field_config.min }}"{% endif %}
    {% if field_config.max is not none %}max="{{ field_config.max }}"{% endif %}
    {% if field_config.step is not none %}step="{{ field_config.step }}"{% endif %}
{%- endmacro %}

{% macro mac_label(field_name, field_config={}) %}
    <label for="id_{{ field_name }}" class="form-label">
        {{ field_config.title or field_name|replace('_', ' ')|title }}
        {% if field_config.required %}
            <span class="text-danger">*</span>
        {% endif %}
    </label>
{% endmacro %}

{% macro mac_input_text(field_name, field_config={}, value='') %}
    <div class="mb-3">
        <div class="d-flex align-items-center gap-1 mb-1">
            {{ mac_label(field_name, field_config) }}
            {% if field_config.description %}
                <div class="tooltip-wrap">
                    <span class="tooltip-icon">?</span>
                    <div class="tooltip-bubble">{{ field_config.description }}</div>
                </div>
            {% endif %}
        </div>
        <input type="text" value="{{ value }}" {{ _build_attrs(field_name, field_config) }} >
    </div>
{% endmacro %}

