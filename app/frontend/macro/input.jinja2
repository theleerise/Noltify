{% macro mac_checkbox(field_name, field_config={}, value=None) %}

    {# =============================
       Boolean config handling
       ============================= #}

    {% set boolean_config = field_config.boolean_config or {} %}

    {% set true_value =
        boolean_config.values.true
        if boolean_config.values and boolean_config.values.true is not none
        else true
    %}

    {% set false_value =
        boolean_config.values.false
        if boolean_config.values and boolean_config.values.false is not none
        else false
    %}

    {% set display_true =
        boolean_config.display.true
        if boolean_config.display and boolean_config.display.true
        else "Sí"
    %}

    {% set display_false =
        boolean_config.display.false
        if boolean_config.display and boolean_config.display.false
        else "No"
    %}

    {% set checked =
        value == true_value
        or value == true
        or value == 1
        or value == "1"
    %}

    <div class="mb-3">
        <div class="form-check">
            <input
                type="checkbox"
                class="form-check-input{% if field_config.className %} {{ field_config.className }}{% endif %}"
                name="{{ field_name }}"
                id="id_{{ field_name }}"
                value="{{ true_value }}"
                {% if checked %}checked{% endif %}
                {% if field_config.readonly %}disabled{% endif %}
            >

            <label class="form-check-label" for="id_{{ field_name }}">
                {{ field_config.title or field_name|replace('_', ' ')|title }}
                <small class="text-muted ms-1">
                    ({{ display_true }} / {{ display_false }})
                </small>
            </label>
            {% if field_config.description %}
                <div class="tooltip-wrap">
                    <span class="tooltip-icon">?</span>
                    <div class="tooltip-bubble">{{ field_config.description }}</div>
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% macro mac_select(field_name, field_config={}, options=[], value='') %}
    <div class="mb-3">
        <div class="d-flex align-items-center gap-1 mb-1">
            {{ mac_label(field_name, field_config) }}
            {% if field_config.description %}
                <div class="tooltip-wrap">
                    <span class="tooltip-icon">?</span>
                    <div class="tooltip-bubble">{{ field_config.description }}</div>
                </div>
            {% endif %}
        </div>
        <select {{ _build_attrs(field_name, field_config) }}>
            <option value="">Seleccione...</option>
            {% for option in options %}
                <option value="{{ option.value }}" {% if option.value == value %}selected{% endif %} >
                    {{ option.label }}
                </option>
            {% endfor %}
        </select>
    </div>
{% endmacro %}

{% macro mac_render_field(field_name, field_config={}, value='', options=[]) %}
    {% if field_config.master_key %}
        {{ mac_api_value_select(field_name, field_config, value) }}
    {% elif field_config.widget == 'file' %}
        {{ mac_input_file(field_name, field_config) }}
    {% elif field_config.type == 'integer' or field_config.type == 'number' or field_config.type == 'decimal' %}
        {{ mac_input_number(field_name, field_config, value) }}
    {% elif field_config.type == 'date' %}
        {{ mac_input_date(field_name, field_config, value) }}
    {% elif field_config.type == 'datetime' %}
        {{ mac_input_datetime(field_name, field_config, value) }}
    {% elif field_config.type == 'time' %}
        {{ mac_input_time(field_name, field_config, value) }}
    {% elif field_config.type == 'boolean' %}
        {{ mac_checkbox(field_name, field_config, value) }}
    {% elif field_config.widget == 'rich_editor' %}
        {{ mac_rich_editor(field_name, field_config, value) }}
    {% elif field_config.widget == 'textarea' %}
        {{ mac_textarea(field_name, field_config, value) }}
    {% else %}
        {{ mac_input_text(field_name, field_config, value) }}
    {% endif %}
{% endmacro %}

{% macro mac_rich_editor(field_name, field_config={}, value='') %}
    <div class="mb-3">
        {{ rich_editor(
            name=field_name,
            id='id_' ~ field_name ~ '_editor',
            label=field_config.title or field_name|replace('_', ' ')|title,
            value=value,
            placeholder=field_config.placeholder or '',
            height=field_config.height or '260px',
            required=field_config.required or false,
            readonly=field_config.readonly or false,
            disabled=field_config.readonly or false,
            help_text=field_config.description
        ) }}
    </div>
{% endmacro %}
